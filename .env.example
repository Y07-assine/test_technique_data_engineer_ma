# Copier en `.env` pour surcharger les valeurs par défaut (toutes optionnelles).
# Ne jamais commiter `.env`.

# --- Période ingérée (bornes incluses) ---
TRIPS_START_DATE=2023-01-01
TRIPS_END_DATE=2023-03-31

# --- API SODA ---
# Token optionnel (https://data.cityofchicago.org/profile/edit/developer_settings) :
# sans token l'API fonctionne mais est plus fortement limitée en débit.
SODA_APP_TOKEN=
SODA_PAGE_SIZE=50000

# --- Datalake (MinIO) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
DATALAKE_BUCKET=datalake

# --- PostgreSQL : métadonnées Airflow ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# --- PostgreSQL : base d'exposition BI ---
# Port publié sur l'hôte (5433 par défaut, pour éviter un PostgreSQL local sur 5432)
POSTGRES_HOST_PORT=5433
ANALYTICS_DB_NAME=analytics
ANALYTICS_DB_USER=analytics
ANALYTICS_DB_PASSWORD=analytics

# --- Airflow ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=change-me-local-only

# --- Spark ---
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=8

# --- Seuils qualité ---
QUALITY_MAX_REJECT_RATE=0.10
QUALITY_MAX_OPTIONAL_NULL_RATE=0.25
QUALITY_MIN_AMOUNT_CONSISTENCY_RATE=0.95
